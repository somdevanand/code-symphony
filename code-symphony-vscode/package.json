{
  "name": "code-symphony-vscode",
  "displayName": "Code Symphony VSCode",
  "description": "Plays musical chords and melodies based on your coding actions in VS Code.",
  "version": "0.0.1",
  "publisher": "JulesDeveloper",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "contributes": {
    "configuration": {
      "title": "Code Symphony",
      "properties": {
        "codeSymphony.enableMusic": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable all sounds from Code Symphony."
        },
        "codeSymphony.volume": {
          "type": "number",
          "default": 0.3,
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Master volume for Code Symphony sounds (0.0 to 1.0)."
        }
      }
    }
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^5.56.0",
    "@typescript-eslint/parser": "^5.56.0",
    "@vscode/test-electron": "^2.3.0",
    "eslint": "^8.36.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "play-sound": "^1.1.6"
  }
}
