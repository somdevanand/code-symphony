# Build output - Exclude test output from the 'out' directory
out/test/**
# Exclude packaged VSIX files from being re-packaged
*.vsix

# Source TypeScript files (compiled JavaScript from 'out/' directory is used)
src/**

# VS Code specific development and test configuration
.vscode/**
.vscode-test/** # Can be for legacy test runners or specific test setups

# Git specific files - Should not be part of the package
.git/**
.gitignore
.gitattributes

# Development configuration files not typically needed in the final package
tsconfig.json
.eslintrc.json
# webpack.config.js # Keep if you might add webpack, remove if definitely not using

# OS-generated files
.DS_Store
*.log

# Other common ignores
# *.yml # Uncomment if you have YAML files that shouldn't be packaged

# IMPORTANT: node_modules is NOT ignored here by default.
# This allows 'vsce package' to bundle runtime 'dependencies' from package.json.
# 'devDependencies' are not packaged. If you have specific large modules in 'dependencies'
# that are actually development tools or platform-specific, you might need to
# add them here explicitly to exclude them, or move them to devDependencies.

# Ensure essential files like README.md and CHANGELOG.md are included by NOT ignoring them.
# By default, files are included unless matched by a pattern here.
# *.md was removed to ensure README.md is included.

# Control for JSON files:
# package.json is always included by vsce.
# package-lock.json is typically not needed in the package; exclude it.
package-lock.json

# Any other specific files or patterns to ignore can be added below.
